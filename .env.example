# Local Docker defaults work without a .env file.
# The Node API automatically reads .env. Never commit your filled-in .env.
# Python environment variables still need to be set in its own terminal.
PORT=3000
DATABASE_URL=mysql://lifejam:lifejam_local_dev@127.0.0.1:3306/lifejam
SEMANTIC_URL=http://127.0.0.1:8001
HF_HOME=/workspace/.cache/huggingface
# Local demonstration only. Use a new database and false for real deployment.
SEED_DEMO=true
# Set true only behind HTTPS.
COOKIE_SECURE=false

# Google / Gmail authentication. See docs/GOOGLE-AND-GMAIL-SETUP.md.
# Use exactly this hostname when opening the site and creating the OAuth redirect.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail sender; SMTP_PASSWORD is a Google App Password, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
